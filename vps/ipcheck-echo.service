[Unit]
Description=ipcheck echo server
After=network-online.target
Wants=network-online.target

[Service]
# За nginx (vps/nginx-ipcheck.conf): TLS и сертификаты на nginx,
# echo слушает только localhost и берёт IP клиента из X-Real-IP.
ExecStart=/usr/local/bin/ipcheck-echo -http 127.0.0.1:8887 -trust-proxy

# Без nginx: echo сам выпускает сертификаты Let's Encrypt (нужны свободные 80 и 443).
#ExecStart=/usr/local/bin/ipcheck-echo -hosts yt.check.example.com,ai.check.example.com -https :443 -cache /var/lib/ipcheck-echo

DynamicUser=yes
StateDirectory=ipcheck-echo
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
